    <script>
        const SUPABASE_URL = 'https://ofshhzsajqfrwndlujvc.supabase.co';
        const SUPABASE_KEY = 'sb_publishable_QABz7TmmSSkWnUIi6L3KBw_bQo1CBIr';
        
        let _supabase;
        try {
            _supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
        } catch (err) {
            showGlobalError("فشل إنشاء اتصال Supabase: " + err.message);
        }

        let rawMaterials = [];
        let inventory = [];
        let productionHistory = [];
        let salesLog = [];
        let invoiceCart = [];
        let exchangeRate = 0;

        try {
            document.getElementById('currentDate').innerText = new Date().toLocaleDateString('ar-SY');
            document.getElementById('invoiceDateStr').innerText = new Date().toLocaleDateString('ar-SY');
        } catch(e) {}

        function showGlobalError(msg) {
            const screen = document.getElementById('errorScreen');
            const details = document.getElementById('errorDetails');
            if(screen && details) {
                details.innerText = msg;
                screen.classList.remove('hidden');
                screen.classList.add('flex');
            }
        }

        function toggleMobileSidebar() {
            document.getElementById('sidebar').classList.toggle('translate-x-full');
        }

        async function fetchAllDataFromSupabase() {
            if (!_supabase) {
                showGlobalError("عميل Supabase غير متاح.");
                return;
            }
            try {
                const { data: rawData, error: err1 } = await _supabase.from('raw_materials').select('*');
                if (err1) throw err1;
                if (rawData) rawMaterials = rawData;

                const { data: prodData, error: err2 } = await _supabase.from('inventory').select('*');
                if (err2) throw err2;
                if (prodData) inventory = prodData;

                const { data: histData, error: err3 } = await _supabase.from('production_history').select('*');
                if (err3) throw err3;
                if (histData) productionHistory = histData;

                const { data: salesData, error: err4 } = await _supabase.from('sales_log').select('*');
                if (err4) throw err4;
                if (salesData) salesLog = salesData;

                renderRawMaterialsTable();
                renderInventoryTable();
                renderInvoiceProducts(inventory);
                renderDashboard();
            } catch (err) {
                console.error("خطأ الجلب:", err);
                showGlobalError("خطأ قاعدة بيانات: " + (err.message || JSON.stringify(err)));
            }
        }

        function calculateProductBOMCost(product) {
            if (!product.bom || product.bom.length === 0) return 0;
            return product.bom.reduce((total, b) => {
                const rawMat = rawMaterials.find(r => r.id === b.rawId);
                const cost = rawMat ? rawMat.costUSD : 0;
                return total + (cost * b.qty);
            }, 0);
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            if (window.innerWidth < 1024) toggleMobileSidebar();

            const titles = { 
                'dashboard': 'لوحة التحكم الرئيسية', 
                'rawWarehouse': 'مستودع المواد الأولية والتكاليف', 
                'production': 'قسم الإنتاج والتجميع', 
                'inventory': 'مستودع المنتجات الجاهزة والربحية', 
                'invoice': 'الفاتورة ونقطة البيع' 
            };
            document.getElementById('pageTitle').innerText = titles[tabId];

            document.querySelectorAll('aside nav button').forEach(btn => btn.classList.remove('text-blue-400', 'bg-slate-800'));
            const activeBtn = document.getElementById('btn-' + tabId);
            if(activeBtn) activeBtn.classList.add('text-blue-400', 'bg-slate-800');

            if (tabId === 'rawWarehouse') renderRawMaterialsTable();
            if (tabId === 'production') setupProductionTab();
            if (tabId === 'inventory') renderInventoryTable();
            if (tabId === 'dashboard') renderDashboard();
        }

        function updateExchangeRate() {
            exchangeRate = parseFloat(document.getElementById('usdExchangeRate').value) || 0;
            renderRawMaterialsTable();
            renderInventoryTable();
            renderInvoiceProducts(inventory);
            updateInvoiceUI();
            renderDashboard();
        }

        function renderRawMaterialsTable() {
            const tbody = document.getElementById('rawMaterialsTable');
            tbody.innerHTML = rawMaterials.map(mat => {
                const itemTotalValue = (mat.costUSD || 0) * (mat.stock || 0);
                return `
                    <tr class="border-b hover:bg-slate-50">
                        <td class="p-3 font-mono text-xs text-purple-600 font-bold">#RAW-${mat.id}</td>
                        <td class="p-3 font-bold text-slate-800">${mat.name}</td>
                        <td class="p-3 text-center font-bold text-purple-700">$${(mat.costUSD || 0).toFixed(2)}</td>
                        <td class="p-3 text-center text-slate-600">${((mat.costUSD || 0) * exchangeRate).toLocaleString()} ل.س</td>
                        <td class="p-3 text-center font-bold text-base text-slate-800">${mat.stock || 0} ${mat.unit || ''}</td>
                        <td class="p-3 text-center font-bold text-emerald-600">$${itemTotalValue.toFixed(2)}</td>
                        <td class="p-3 text-center">
                            <div class="flex items-center justify-center gap-2">
                                <button onclick="openEditRawModal(${mat.id})" class="p-1.5 bg-blue-50 text-blue-600 rounded text-xs font-bold"><i class="fas fa-edit"></i></button>
                                <button onclick="deleteRawMaterial(${mat.id})" class="p-1.5 bg-red-50 text-red-600 rounded text-xs font-bold"><i class="fas fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function toggleAddRawModal() {
            const m = document.getElementById('addRawModal');
            m.classList.toggle('hidden'); m.classList.toggle('flex');
        }

        async function handleAddNewRawMaterial(e) {
            e.preventDefault();
            const name = document.getElementById('newRawName').value;
            const costUSD = parseFloat(document.getElementById('newRawCostUSD').value) || 0;
            const unit = document.getElementById('newRawUnit').value;
            const stock = parseInt(document.getElementById('newRawStock').value);
            const newMat = { name, costUSD, unit, stock };

            const { data, error } = await _supabase.from('raw_materials').insert([newMat]).select();
            if (error) { showGlobalError(error.message); return; }
            if (data && data[0]) rawMaterials.push(data[0]);
            renderRawMaterialsTable();
            toggleAddRawModal();
            showToast('تمت إضافة المادة بنجاح', 'success');
            e.target.reset();
        }

        function toggleRestockRawModal() {
            const modal = document.getElementById('restockRawModal');
            modal.classList.toggle('hidden'); modal.classList.toggle('flex');
            if (!modal.classList.contains('hidden')) {
                document.getElementById('restockSelectId').innerHTML = rawMaterials.map(r => `<option value="${r.id}">${r.name} (المتوفر: ${r.stock})</option>`).join('');
                onRestockMaterialSelect();
            }
        }

        function onRestockMaterialSelect() {
            const rawId = parseInt(document.getElementById('restockSelectId').value);
            const mat = rawMaterials.find(r => r.id === rawId);
            if (mat) document.getElementById('restockNewCostUSD').value = mat.costUSD;
        }

        async function handleRestockRaw(e) {
            e.preventDefault();
            const rawId = parseInt(document.getElementById('restockSelectId').value);
            const addQty = parseInt(document.getElementById('restockAddQty').value) || 0;
            const newCost = parseFloat(document.getElementById('restockNewCostUSD').value) || 0;
            const mat = rawMaterials.find(r => r.id === rawId);
            if (mat) {
                mat.stock += addQty;
                mat.costUSD = newCost;
                await _supabase.from('raw_materials').update({ stock: mat.stock, costUSD: mat.costUSD }).eq('id', rawId);
                renderRawMaterialsTable();
                toggleRestockRawModal();
                showToast('تم التوريد بنجاح', 'success');
            }
        }

        function openEditRawModal(id) {
            const mat = rawMaterials.find(r => r.id === id);
            if (!mat) return;
            document.getElementById('editRawId').value = mat.id;
            document.getElementById('editRawName').value = mat.name;
            document.getElementById('editRawCostUSD').value = mat.costUSD;
            document.getElementById('editRawUnit').value = mat.unit;
            document.getElementById('editRawStock').value = mat.stock;
            toggleEditRawModal();
        }

        function toggleEditRawModal() {
            const m = document.getElementById('editRawModal');
            m.classList.toggle('hidden'); m.classList.toggle('flex');
        }

        async function handleSaveRawEdit(e) {
            e.preventDefault();
            const id = parseInt(document.getElementById('editRawId').value);
            const mat = rawMaterials.find(r => r.id === id);
            if (mat) {
                mat.name = document.getElementById('editRawName').value;
                mat.costUSD = parseFloat(document.getElementById('editRawCostUSD').value) || 0;
                mat.unit = document.getElementById('editRawUnit').value;
                mat.stock = parseInt(document.getElementById('editRawStock').value);
                await _supabase.from('raw_materials').update({ name: mat.name, costUSD: mat.costUSD, unit: mat.unit, stock: mat.stock }).eq('id', id);
                renderRawMaterialsTable();
                toggleEditRawModal();
                showToast('تم التحديث بنجاح', 'success');
            }
        }

        async function deleteRawMaterial(id) {
            if (confirm('هل أنت متأكد من الحذف؟')) {
                await _supabase.from('raw_materials').delete().eq('id', id);
                rawMaterials = rawMaterials.filter(r => r.id !== id);
                renderRawMaterialsTable();
                showToast('تم الحذف', 'success');
            }
        }

        function renderInventoryTable() {
            const tbody = document.getElementById('inventoryTable');
            tbody.innerHTML = inventory.map(item => {
                const bomCostUSD = calculateProductBOMCost(item);
                const profitUSD = (item.priceUSD || 0) - bomCostUSD;
                return `
                    <tr class="border-b hover:bg-slate-50">
                        <td class="p-3"><span class="bg-slate-100 text-slate-700 text-xs px-2 py-1 rounded font-bold">${item.category || 'عام'}</span></td>
                        <td class="p-3 font-bold text-slate-800">${item.name}</td>
                        <td class="p-3 text-center text-purple-700 font-bold">$${bomCostUSD.toFixed(2)}</td>
                        <td class="p-3 text-center text-emerald-600 font-bold">$${(item.priceUSD || 0).toFixed(2)}</td>
                        <td class="p-3 text-center font-bold ${profitUSD >= 0 ? 'text-blue-600' : 'text-red-600'}">+$${profitUSD.toFixed(2)}</td>
                        <td class="p-3 text-center text-slate-600">${((item.priceUSD || 0) * exchangeRate).toLocaleString()} ل.س</td>
                        <td class="p-3 text-center font-bold text-base text-slate-800">${item.stock || 0}</td>
                        <td class="p-3 text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <button onclick="openEditBOMModal(${item.id})" class="p-1.5 bg-purple-50 text-purple-600 rounded text-xs font-bold"><i class="fas fa-cogs"></i></button>
                                <button onclick="openEditProductModal(${item.id})" class="p-1.5 bg-blue-50 text-blue-600 rounded text-xs font-bold"><i class="fas fa-edit"></i></button>
                                <button onclick="deleteProduct(${item.id})" class="p-1.5 bg-red-50 text-red-600 rounded text-xs font-bold"><i class="fas fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function openEditBOMModal(id) {
            const product = inventory.find(p => p.id === id);
            if (!product) return;
            document.getElementById('bomEditingProdId').value = product.id;
            document.getElementById('bomModalProductName').innerText = product.name;
            document.getElementById('selectRawToAdd').innerHTML = rawMaterials.map(r => `<option value="${r.id}">${r.name} ($${r.costUSD})</option>`).join('');
            renderCurrentBOMList(product);
            toggleEditBOMModal();
        }

        function toggleEditBOMModal() {
            const m = document.getElementById('editBOMModal');
            m.classList.toggle('hidden'); m.classList.toggle('flex');
            renderInventoryTable();
        }

        function renderCurrentBOMList(product) {
            const container = document.getElementById('currentBOMListContainer');
            if (!product.bom || product.bom.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-400 text-center py-2">لا توجد مواد مسجلة.</p>`;
                return;
            }
            container.innerHTML = product.bom.map((b, index) => {
                const rawMat = rawMaterials.find(r => r.id === b.rawId);
                return `
                    <div class="flex justify-between items-center p-2 bg-white border rounded text-xs">
                        <span class="font-bold text-slate-700">${rawMat ? rawMat.name : 'مكون محذوف'}</span>
                        <div class="flex items-center gap-3">
                            <span class="bg-slate-100 px-2 py-1 rounded font-bold">${b.qty} ${rawMat ? rawMat.unit : ''}</span>
                            <button onclick="removeRawFromProductBOM(${product.id}, ${index})" class="text-red-500 p-1"><i class="fas fa-times-circle"></i></button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        async function addRawToCurrentProductBOM() {
            const prodId = parseInt(document.getElementById('bomEditingProdId').value);
            const rawId = parseInt(document.getElementById('selectRawToAdd').value);
            const qty = parseInt(document.getElementById('inputRawQty').value) || 1;
            const product = inventory.find(p => p.id === prodId);
            if (!product) return;
            if (!product.bom) product.bom = [];
            const existing = product.bom.find(b => b.rawId === rawId);
            if (existing) existing.qty += qty;
            else product.bom.push({ rawId, qty });
            await _supabase.from('inventory').update({ bom: product.bom }).eq('id', prodId);
            renderCurrentBOMList(product);
            showToast('تمت الإضافة', 'success');
        }

        async function removeRawFromProductBOM(prodId, index) {
            const product = inventory.find(p => p.id === prodId);
            if (!product || !product.bom) return;
            product.bom.splice(index, 1);
            await _supabase.from('inventory').update({ bom: product.bom }).eq('id', prodId);
            renderCurrentBOMList(product);
            showToast('تم الحذف', 'success');
        }

        function toggleAddProductModal() {
            const m = document.getElementById('addProductModal');
            m.classList.toggle('hidden'); m.classList.toggle('flex');
        }

        async function handleAddNewProduct(e) {
            e.preventDefault();
            const category = document.getElementById('newProdCategory').value;
            const name = document.getElementById('newProdName').value;
            const priceUSD = parseFloat(document.getElementById('newProdPriceUSD').value);
            const stock = parseInt(document.getElementById('newProdStock').value);
            const newProd = { category, name, priceUSD, stock, bom: [] };
            
            const { data, error } = await _supabase.from('inventory').insert([newProd]).select();
            if (error) { showGlobalError(error.message); return; }
            if (data && data[0]) inventory.push(data[0]);
            renderInventoryTable();
            renderInvoiceProducts(inventory);
            toggleAddProductModal();
            showToast('تمت إضافة المنتج', 'success');
            e.target.reset();
        }

        function openEditProductModal(id) {
            const item = inventory.find(p => p.id === id);
            if (!item) return;
            document.getElementById('editProdId').value = item.id;
            document.getElementById('editProdCategory').value = item.category;
            document.getElementById('editProdName').value = item.name;
            document.getElementById('editProdPriceUSD').value = item.priceUSD;
            document.getElementById('editProdStock').value = item.stock;
            toggleEditProductModal();
        }

        function toggleEditProductModal() {
            const m = document.getElementById('editProductModal');
            m.classList.toggle('hidden'); m.classList.toggle('flex');
        }

        async function handleSaveProductEdit(e) {
            e.preventDefault();
            const id = parseInt(document.getElementById('editProdId').value);
            const item = inventory.find(p => p.id === id);
            if (item) {
                item.category = document.getElementById('editProdCategory').value;
                item.name = document.getElementById('editProdName').value;
                item.priceUSD = parseFloat(document.getElementById('editProdPriceUSD').value);
                item.stock = parseInt(document.getElementById('editProdStock').value);
                await _supabase.from('inventory').update({ category: item.category, name: item.name, priceUSD: item.priceUSD, stock: item.stock }).eq('id', id);
                renderInventoryTable();
                renderInvoiceProducts(inventory);
                toggleEditProductModal();
                showToast('تم التحديث', 'success');
            }
        }

        async function deleteProduct(id) {
            if (confirm('هل أنت متأكد من الحذف؟')) {
                await _supabase.from('inventory').delete().eq('id', id);
                inventory = inventory.filter(p => p.id !== id);
                renderInventoryTable();
                renderInvoiceProducts(inventory);
                showToast('تم الحذف', 'success');
            }
        }

        function setupProductionTab() {
            document.getElementById('prodSelectProduct').innerHTML = inventory.map(item => `<option value="${item.id}">${item.name}</option>`).join('');
            updateBOMPreview();
            renderProductionHistory();
        }

        function updateBOMPreview() {
            const prodId = parseInt(document.getElementById('prodSelectProduct').value);
            const qtyToProduce = parseInt(document.getElementById('prodQuantity').value) || 1;
            const product = inventory.find(p => p.id === prodId);
            if (!product) return;

            const previewContainer = document.getElementById('bomListPreview');
            const badge = document.getElementById('bomStatusBadge');
            const btn = document.getElementById('btnExecuteProduction');
            const batchCostLabel = document.getElementById('bomBatchTotalCost');

            if (!product.bom || product.bom.length === 0) {
                previewContainer.innerHTML = `<p class="text-slate-400">لا توجد مكونات مسجلة.</p>`;
                badge.innerText = "لا توجد وصفة";
                badge.className = "text-[10px] px-2 py-0.5 rounded font-bold bg-amber-100 text-amber-700";
                batchCostLabel.innerText = "$0.00";
                btn.disabled = true;
                return;
            }

            let allAvailable = true;
            let previewHTML = '';
            let singleUnitCost = 0;

            product.bom.forEach(b => {
                const rawMat = rawMaterials.find(r => r.id === b.rawId);
                const requiredTotal = b.qty * qtyToProduce;
                const isSufficient = rawMat && rawMat.stock >= requiredTotal;
                const matCost = rawMat ? rawMat.costUSD : 0;
                singleUnitCost += (matCost * b.qty);
                if (!isSufficient) allAvailable = false;

                previewHTML += `
                    <div class="flex justify-between items-center p-2 rounded ${isSufficient ? 'bg-emerald-50 text-emerald-900' : 'bg-red-50 text-red-900'}">
                        <span>${rawMat ? rawMat.name : 'مكون محذوف'}</span>
                        <span class="font-bold">${requiredTotal} (المتوفر: ${rawMat ? rawMat.stock : 0})</span>
                    </div>
                `;
            });

            previewContainer.innerHTML = previewHTML;
            const totalBatchCost = singleUnitCost * qtyToProduce;
            batchCostLabel.innerText = `$${totalBatchCost.toFixed(2)}`;

            if (allAvailable) {
                badge.innerText = "المواد متوفرة";
                badge.className = "text-[10px] px-2 py-0.5 rounded font-bold bg-emerald-100 text-emerald-700";
                btn.disabled = false;
            } else {
                badge.innerText = "مكونات ناقصة!";
                badge.className = "text-[10px] px-2 py-0.5 rounded font-bold bg-red-100 text-red-700";
                btn.disabled = true;
            }
        }

        async function handleProductionSubmit(e) {
            e.preventDefault();
            const prodId = parseInt(document.getElementById('prodSelectProduct').value);
            const qtyToProduce = parseInt(document.getElementById('prodQuantity').value);
            const product = inventory.find(p => p.id === prodId);
            if (!product || !product.bom) return;

            for (let b of product.bom) {
                const rawMat = rawMaterials.find(r => r.id === b.rawId);
                if (rawMat) {
                    rawMat.stock -= (b.qty * qtyToProduce);
                    await _supabase.from('raw_materials').update({ stock: rawMat.stock }).eq('id', rawMat.id);
                }
            }

            product.stock += qtyToProduce;
            await _supabase.from('inventory').update({ stock: product.stock }).eq('id', prodId);

            const newLog = {
                productName: product.name,
                qty: qtyToProduce,
                time: new Date().toLocaleTimeString('ar-SY', { hour: '2-digit', minute: '2-digit' })
            };
            
            const { data, error } = await _supabase.from('production_history').insert([newLog]).select();
            if (error) { showGlobalError(error.message); return; }
            if (data && data[0]) productionHistory.unshift(data[0]);

            showToast('تم التصنيع بنجاح', 'success');
            updateBOMPreview();
            renderProductionHistory();
            renderRawMaterialsTable();
            renderInventoryTable();
        }

        function renderProductionHistory() {
            document.getElementById('productionHistoryTable').innerHTML = productionHistory.map(log => `
                <tr class="border-b">
                    <td class="p-3 font-bold">${log.productName}</td>
                    <td class="p-3 text-center font-bold text-emerald-600">+${log.qty}</td>
                    <td class="p-3 text-center text-xs text-slate-500">${log.time}</td>
                    <td class="p-3 text-center"><span class="bg-blue-100 text-blue-700 text-xs px-2.5 py-1 rounded-full font-bold">جاهز</span></td>
                </tr>
            `).join('');
        }

        function renderInvoiceProducts(productsToRender) {
            document.getElementById('invoiceProductsList').innerHTML = productsToRender.map(product => `
                <div class="p-3 bg-white border border-slate-200 rounded-lg cursor-pointer flex justify-between items-center" onclick="addToInvoice(${product.id})">
                    <div>
                        <h4 class="font-bold text-xs text-slate-800">${product.name}</h4>
                        <p class="text-xs text-emerald-600 font-bold">$${(product.priceUSD || 0).toFixed(2)}</p>
                        <p class="text-[10px] text-slate-400">المتوفر: ${product.stock || 0}</p>
                    </div>
                    <i class="fas fa-plus text-blue-500"></i>
                </div>
            `).join('');
        }

        function filterInvoiceProducts() {
            const cat = document.getElementById('invoiceCatSelect').value;
            const term = document.getElementById('searchInput').value.toLowerCase();
            let filtered = inventory;
            if (cat !== 'الكل') filtered = filtered.filter(i => i.category === cat);
            if (term) filtered = filtered.filter(i => i.name.toLowerCase().includes(term));
            renderInvoiceProducts(filtered);
        }

        function addToInvoice(id) {
            const product = inventory.find(p => p.id === id);
            if (!product || (product.stock || 0) <= 0) {
                showToast('غير متوفر بالمستودع!', 'error');
                return;
            }
            const existing = invoiceCart.find(i => i.id === id);
            if (existing) {
                if (existing.qty + 1 > product.stock) { showToast('تجاوزت المخزون!', 'error'); return; }
                existing.qty++;
            } else {
                invoiceCart.push({ ...product, qty: 1 });
            }
            updateInvoiceUI();
        }

        function changeQty(id, amt) {
            const item = invoiceCart.find(i => i.id === id);
            const product = inventory.find(p => p.id === id);
            if (item) {
                if (amt > 0 && item.qty + amt > product.stock) { showToast('تجاوزت المخزون!', 'error'); return; }
                item.qty += amt;
                if (item.qty <= 0) invoiceCart = invoiceCart.filter(i => i.id !== id);
                updateInvoiceUI();
            }
        }

        function updateInvoiceUI() {
            let totalUSD = 0;
            document.getElementById('invoiceItems').innerHTML = invoiceCart.map(item => {
                const total = (item.priceUSD || 0) * item.qty;
                totalUSD += total;
                return `
                    <tr class="border-b">
                        <td class="p-3 font-medium">${item.name}</td>
                        <td class="p-3 text-center">
                            <button onclick="changeQty(${item.id}, 1)" class="px-1.5 bg-slate-200 rounded font-bold">+</button>
                            <span class="px-2 font-bold">${item.qty}</span>
                            <button onclick="changeQty(${item.id}, -1)" class="px-1.5 bg-slate-200 rounded font-bold">-</button>
                        </td>
                        <td class="p-3 text-center">$${(item.priceUSD || 0).toFixed(2)}</td>
                        <td class="p-3 text-center font-bold">$${total.toFixed(2)}</td>
                        <td class="p-3 text-center"><button onclick="changeQty(${item.id}, -999)" class="text-red-500"><i class="fas fa-trash"></i></button></td>
                    </tr>
                `;
            }).join('');
            document.getElementById('grandTotalUSD').innerText = '$' + totalUSD.toFixed(2);
            document.getElementById('grandTotalSYP').innerText = (totalUSD * exchangeRate).toLocaleString() + ' ل.س';
        }

        function clearInvoice() {
            invoiceCart = [];
            updateInvoiceUI();
        }

        async function processCheckoutAndDeduct() {
            if (invoiceCart.length === 0) return;
            let totalUSD = 0;
            for (let item of invoiceCart) {
                const prod = inventory.find(p => p.id === item.id);
                if (prod) {
                    prod.stock -= item.qty;
                    await _supabase.from('inventory').update({ stock: prod.stock }).eq('id', prod.id);
                }
                totalUSD += (item.priceUSD || 0) * item.qty;
            }

            const newSale = {
                id: 'INV-' + (1000 + salesLog.length + 1),
                customer: document.getElementById('custName').value || 'عميل نقدي',
                totalUSD: totalUSD,
                totalSYP: totalUSD * exchangeRate,
                time: new Date().toLocaleTimeString('ar-SY', { hour: '2-digit', minute: '2-digit' })
            };

            const { data, error } = await _supabase.from('sales_log').insert([newSale]).select();
            if (error) { showGlobalError(error.message); return; }
            if (data && data[0]) salesLog.unshift(data[0]);

            showToast('تمت عملية البيع بنجاح', 'success');
            invoiceCart = [];
            document.getElementById('custName').value = '';
            document.getElementById('custPhone').value = '';
            updateInvoiceUI();
            renderInventoryTable();
            renderInvoiceProducts(inventory);
            renderDashboard();
        }

        function renderDashboard() {
            const sumUSD = salesLog.reduce((a, b) => a + (b.totalUSD || 0), 0);
            document.getElementById('dashTotalUSD').innerText = '$' + sumUSD.toFixed(2);
            document.getElementById('dashTotalSYP').innerText = (sumUSD * exchangeRate).toLocaleString() + ' ل.س';
            
            const rawVal = rawMaterials.reduce((a, b) => a + ((b.costUSD || 0) * (b.stock || 0)), 0);
            document.getElementById('dashRawTotalValue').innerText = '$' + rawVal.toFixed(2);
            document.getElementById('dashProdLogsCount').innerText = productionHistory.length;

            document.getElementById('dashSalesLog').innerHTML = salesLog.map(s => `
                <tr class="border-b"><td class="p-2 font-bold text-blue-600">${s.id}</td><td class="p-2">${s.customer}</td><td class="p-2 text-center text-emerald-600">$${(s.totalUSD || 0).toFixed(2)}</td><td class="p-2 text-center text-blue-600">${(s.totalSYP || 0).toLocaleString()} ل.س</td></tr>
            `).join('');

            document.getElementById('dashProdHistory').innerHTML = productionHistory.map(p => `
                <tr class="border-b"><td class="p-2 font-bold">${p.productName}</td><td class="p-2 text-center text-amber-600">+${p.qty}</td><td class="p-2 text-center text-xs text-slate-500">${p.time}</td></tr>
            `).join('');
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `p-3 rounded-lg shadow-lg text-white font-bold text-xs flex items-center gap-2 ${type === 'error' ? 'bg-red-600' : 'bg-emerald-600'}`;
            toast.innerHTML = `<i class="fas ${type === 'error' ? 'fa-exclamation-circle' : 'fa-check-circle'}"><span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        // تشغيل الجلب عند بدء التحميل
        fetchAllDataFromSupabase();
    </script>
</body>
</html>
