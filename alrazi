<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>شركة الرازي للحلول التقنية</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Supabase JS Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; -webkit-tap-highlight-color: transparent; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
    </style>
</head>
<body class="flex flex-col lg:flex-row h-screen overflow-hidden text-gray-800">

    <div id="toastContainer" class="fixed bottom-5 left-5 z-50 flex flex-col gap-2 no-print"></div>

    <!-- نافذة طوارئ تظهر في حال حدوث أي خطأ بدلاً من إغلاق التطبيق -->
    <div id="errorScreen" class="hidden fixed inset-0 bg-red-900 text-white z-50 p-6 flex flex-col justify-center items-center text-center">
        <i class="fas fa-exclamation-triangle text-5xl mb-4 text-yellow-300"></i>
        <h2 class="text-xl font-bold mb-2">تنبيه تشغيلي</h2>
        <p id="errorDetails" class="text-sm bg-red-950 p-4 rounded-lg max-w-md mb-4 font-mono"></p>
        <button onclick="location.reload()" class="bg-white text-red-900 font-bold px-6 py-2 rounded-lg text-sm">إعادة المحاولة</button>
    </div>

    <!-- زر القائمة للجوال -->
    <div class="lg:hidden bg-slate-900 text-white p-4 flex justify-between items-center no-print shrink-0">
        <span class="font-bold text-blue-400 text-sm">شركة الرازي للحلول التقنية</span>
        <button onclick="toggleMobileSidebar()" class="p-2 bg-slate-800 rounded-lg text-white">
            <i class="fas fa-bars text-lg"></i>
        </button>
    </div>

    <!-- القائمة الجانبية -->
    <aside id="sidebar" class="fixed inset-y-0 right-0 z-40 w-64 bg-slate-900 text-white flex flex-col no-print border-l border-slate-800 transform translate-x-full lg:translate-x-0 transition-transform duration-300">
        <div class="p-6 text-center border-b border-slate-800 flex justify-between items-center lg:block">
            <div>
                <div class="w-12 h-12 bg-blue-600 rounded-lg mx-auto flex items-center justify-center text-xl font-bold mb-2 shadow-lg">
                    <i class="fas fa-microchip"></i>
                </div>
                <h2 class="text-xl font-bold text-blue-400">شركة الرازي</h2>
                <p class="text-xs text-slate-400 mt-1">إدارة التكاليف والإنتاج والبيع</p>
            </div>
            <button onclick="toggleMobileSidebar()" class="lg:hidden text-slate-400 hover:text-white">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 p-4 space-y-2 overflow-y-auto">
            <button onclick="switchTab('dashboard')" id="btn-dashboard" class="w-full text-right p-3 rounded-lg hover:bg-slate-800 transition flex items-center gap-3 text-blue-400 bg-slate-800">
                <i class="fas fa-chart-line text-blue-400 w-5 text-center"></i>
                <span class="font-medium text-sm">لوحة التحكم</span>
            </button>
            <button onclick="switchTab('rawWarehouse')" id="btn-rawWarehouse" class="w-full text-right p-3 rounded-lg hover:bg-slate-800 transition flex items-center gap-3 text-slate-300">
                <i class="fas fa-microchip text-purple-400 w-5 text-center"></i>
                <span class="font-medium text-sm">مستودع المواد الأولية</span>
            </button>
            <button onclick="switchTab('production')" id="btn-production" class="w-full text-right p-3 rounded-lg hover:bg-slate-800 transition flex items-center gap-3 text-slate-300">
                <i class="fas fa-industry text-amber-400 w-5 text-center"></i>
                <span class="font-medium text-sm">قسم الإنتاج والتجميع</span>
            </button>
            <button onclick="switchTab('inventory')" id="btn-inventory" class="w-full text-right p-3 rounded-lg hover:bg-slate-800 transition flex items-center gap-3 text-slate-300">
                <i class="fas fa-boxes text-emerald-400 w-5 text-center"></i>
                <span class="font-medium text-sm">مستودع المنتجات الجاهزة</span>
            </button>
            <button onclick="switchTab('invoice')" id="btn-invoice" class="w-full text-right p-3 rounded-lg hover:bg-slate-800 transition flex items-center gap-3 text-slate-300">
                <i class="fas fa-file-invoice-dollar text-cyan-400 w-5 text-center"></i>
                <span class="font-medium text-sm">الفاتورة ونقطة البيع</span>
            </button>
        </nav>

        <div class="p-4 border-t border-slate-800 bg-slate-950">
            <label class="block text-[11px] text-slate-400 mb-1">سعر صرف الدولار (ل.س):</label>
            <input type="number" id="usdExchangeRate" value="0" onchange="updateExchangeRate()" class="w-full p-2 bg-slate-800 border border-slate-700 rounded text-xs text-amber-400 font-bold focus:outline-none">
        </div>
    </aside>

    <!-- المحتوى الرئيسي -->
    <main class="flex-1 flex flex-col h-screen overflow-y-auto bg-slate-50 w-full">
        <header class="bg-white shadow-xs px-6 py-4 no-print flex justify-between items-center border-b border-slate-200 shrink-0">
            <h1 class="text-lg md:text-xl font-bold text-slate-800" id="pageTitle">لوحة التحكم الرئيسية</h1>
            <span id="currentDate" class="text-xs font-bold text-slate-500 bg-slate-100 px-3 py-1 rounded-full"></span>
        </header>

        <div class="p-4 md:p-6 flex-1">
            <section id="dashboard" class="tab-content active space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs flex justify-between items-center">
                        <div><p class="text-xs text-slate-500 font-bold">مبيعات اليوم ($)</p><h3 class="text-2xl font-bold text-slate-800" id="dashTotalUSD">$0</h3></div>
                        <i class="fas fa-dollar-sign text-2xl text-emerald-500 bg-emerald-50 p-3 rounded-lg"></i>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs flex justify-between items-center">
                        <div><p class="text-xs text-slate-500 font-bold">مبيعات اليوم (ل.س)</p><h3 class="text-xl font-bold text-blue-600" id="dashTotalSYP">0 ل.س</h3></div>
                        <i class="fas fa-coins text-2xl text-blue-500 bg-blue-50 p-3 rounded-lg"></i>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs flex justify-between items-center">
                        <div><p class="text-xs text-slate-500 font-bold">قيمة مواد المخزون الأولية</p><h3 class="text-2xl font-bold text-purple-600" id="dashRawTotalValue">$0</h3></div>
                        <i class="fas fa-warehouse text-2xl text-purple-500 bg-purple-50 p-3 rounded-lg"></i>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs flex justify-between items-center">
                        <div><p class="text-xs text-slate-500 font-bold">عمليات التصنيع المنفذة</p><h3 class="text-2xl font-bold text-amber-600" id="dashProdLogsCount">0</h3></div>
                        <i class="fas fa-industry text-2xl text-amber-500 bg-amber-50 p-3 rounded-lg"></i>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-2xs overflow-x-auto">
                        <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2"><i class="fas fa-history text-blue-600"></i> أحدث المبيعات</h3>
                        <table class="w-full text-right text-xs min-w-[300px]">
                            <thead><tr class="bg-slate-100 border-b text-slate-600"><th class="p-2.5">الفاتورة</th><th class="p-2.5">العميل</th><th class="p-2.5 text-center">المبلغ ($)</th><th class="p-2.5 text-center">المبلغ (ل.س)</th></tr></thead>
                            <tbody id="dashSalesLog"></tbody>
                        </table>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-2xs overflow-x-auto">
                        <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2"><i class="fas fa-cogs text-amber-600"></i> أحدث عمليات التصنيع</h3>
                        <table class="w-full text-right text-xs min-w-[300px]">
                            <thead><tr class="bg-slate-100 border-b text-slate-600"><th class="p-2.5">المنتج المصنّع</th><th class="p-2.5 text-center">الكمية المصنّعة</th><th class="p-2.5 text-center">التاريخ والتوقيت</th></tr></thead>
                            <tbody id="dashProdHistory"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section id="rawWarehouse" class="tab-content space-y-6">
                <div class="bg-white p-6 rounded-xl border border-slate-200">
                    <div class="flex flex-col md:flex-row justify-between items-center mb-6 border-b pb-4 gap-3">
                        <div>
                            <h2 class="text-xl font-bold text-slate-800">مستودع المواد الأولية والقطع الإلكترونية</h2>
                            <p class="text-xs text-slate-500">إدارة تكاليف القطع والكميات المتاحة عبر قاعدة البيانات</p>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <button onclick="toggleRestockRawModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-bold flex items-center gap-2">
                                <i class="fas fa-cart-plus"></i> توريد / تحديث سعر
                            </button>
                            <button onclick="toggleAddRawModal()" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-bold flex items-center gap-2">
                                <i class="fas fa-plus"></i> مادة جديدة
                            </button>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-right text-sm border-collapse min-w-[600px]">
                            <thead><tr class="bg-slate-100 border-b text-slate-600"><th class="p-3">رمز المادة</th><th class="p-3">اسم المادة</th><th class="p-3 text-center">التكلفة ($)</th><th class="p-3 text-center">التكلفة (ل.س)</th><th class="p-3 text-center">المتوفر</th><th class="p-3 text-center">إجمالي القيمة ($)</th><th class="p-3 text-center">إجراءات</th></tr></thead>
                            <tbody id="rawMaterialsTable"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section id="production" class="tab-content space-y-6">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-2xs lg:col-span-1">
                        <h3 class="font-bold text-lg text-slate-800 mb-4 border-b pb-2 flex items-center gap-2"><i class="fas fa-industry text-amber-500"></i> أمر تصنيع جديد</h3>
                        <form onsubmit="handleProductionSubmit(event)" class="space-y-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">اختر المنتج المراد تصنيعه:</label>
                                <select id="prodSelectProduct" onchange="updateBOMPreview()" class="w-full p-2.5 border rounded-lg text-sm bg-slate-50 font-bold"></select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">الكمية المطلوبة:</label>
                                <input type="number" id="prodQuantity" value="1" min="1" oninput="updateBOMPreview()" class="w-full p-2.5 border rounded-lg text-sm font-bold">
                            </div>
                            <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
                                <h4 class="text-xs font-bold text-slate-700 mb-2 border-b pb-1 flex items-center justify-between">
                                    <span>المواد المطلوبة:</span>
                                    <span id="bomStatusBadge" class="text-[10px] px-2 py-0.5 rounded font-bold"></span>
                                </h4>
                                <div id="bomListPreview" class="space-y-1.5 text-xs"></div>
                                <div class="mt-3 pt-2 border-t border-slate-200 flex justify-between font-bold text-xs text-purple-700">
                                    <span>إجمالي تكلفة المكونات:</span>
                                    <span id="bomBatchTotalCost">$0.00</span>
                                </div>
                            </div>
                            <button type="submit" id="btnExecuteProduction" class="w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 rounded-lg text-sm transition flex items-center justify-center gap-2 shadow-sm">
                                <i class="fas fa-cogs"></i> تأكيد التصنيع وخصم المواد
                            </button>
                        </form>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-2xs lg:col-span-2 overflow-x-auto">
                        <h3 class="font-bold text-lg text-slate-800 mb-4 border-b pb-2 flex items-center gap-2"><i class="fas fa-boxes-stacked text-blue-600"></i> سجل المخرجات المصنعة</h3>
                        <table class="w-full text-right text-sm min-w-[400px]">
                            <thead><tr class="bg-slate-100 border-b text-slate-600"><th class="p-3">المنتج</th><th class="p-3 text-center">الكمية</th><th class="p-3 text-center">التوقيت</th><th class="p-3 text-center">الحالة</th></tr></thead>
                            <tbody id="productionHistoryTable"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section id="inventory" class="tab-content space-y-6">
                <div class="bg-white p-6 rounded-xl border border-slate-200">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-6 border-b pb-4">
                        <div>
                            <h2 class="text-xl font-bold text-slate-800">مستودع المنتجات الجاهزة والربحية</h2>
                            <p class="text-xs text-slate-500">حساب تكلفة الإنتاج والربح وسعر البيع</p>
                        </div>
                        <button onclick="toggleAddProductModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg text-sm font-bold flex items-center gap-2">
                            <i class="fas fa-plus"></i> إضافة منتج جاهز
                        </button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-right text-sm border-collapse min-w-[700px]">
                            <thead><tr class="bg-slate-100 border-b text-slate-600"><th class="p-3">القسم</th><th class="p-3">اسم المنتج</th><th class="p-3 text-center">تكلفة المكونات ($)</th><th class="p-3 text-center">سعر البيع ($)</th><th class="p-3 text-center">ربح القطعة ($)</th><th class="p-3 text-center">سعر البيع (ل.س)</th><th class="p-3 text-center">المتوفر</th><th class="p-3 text-center">إجراءات</th></tr></thead>
                            <tbody id="inventoryTable"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section id="invoice" class="tab-content">
                <div class="flex flex-col xl:flex-row gap-6">
                    <div class="w-full xl:w-1/3 bg-white rounded-xl p-4 border border-slate-200 h-[350px] xl:h-[calc(100vh-180px)] flex flex-col">
                        <h3 class="font-bold text-slate-800 mb-3 border-b pb-2">اختيار المنتجات للبيع</h3>
                        <select id="invoiceCatSelect" onchange="filterInvoiceProducts()" class="w-full p-2 border rounded-lg text-xs mb-2 bg-slate-50">
                            <option value="الكل">جميع الأقسام</option>
                            <option value="الحمايات">الحمايات</option>
                            <option value="الحمايات الصناعية (فولت – سايكل)">الحمايات الصناعية</option>
                            <option value="مقاييس مستوى السوائل">مقاييس مستوى السوائل</option>
                            <option value="الشواحن الإلكترونية وأنظمة الطاقة">الشواحن وأنظمة الطاقة والفائض</option>
                            <option value="أوتوماتيك الدرج">أوتوماتيك الدرج</option>
                            <option value="منظمات الجهد">منظمات الجهد</option>
                        </select>
                        <input type="text" id="searchInput" placeholder="بحث باسم المنتج..." class="w-full p-2 border rounded-lg text-xs mb-3" onkeyup="filterInvoiceProducts()">
                        <div class="overflow-y-auto flex-1 border rounded-lg p-2 space-y-2 bg-slate-50" id="invoiceProductsList"></div>
                    </div>
                    <div class="w-full xl:w-2/3 bg-white rounded-xl p-6 md:p-8 border border-slate-200">
                        <div class="flex justify-between items-start border-b pb-4 mb-6">
                            <div>
                                <h1 class="text-xl md:text-2xl font-bold text-slate-800">فاتورة مبيعات</h1>
                                <p class="text-xs text-slate-500">شركة الرازي للحلول التقنية</p>
                            </div>
                            <div class="text-left">
                                <h2 class="text-base md:text-lg font-bold text-blue-600">Al-Razi Tech</h2>
                                <p class="text-xs text-slate-400" id="invoiceDateStr"></p>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                            <input type="text" id="custName" class="p-2 border rounded-lg text-sm" placeholder="اسم العميل">
                            <input type="text" id="custPhone" class="p-2 border rounded-lg text-sm" placeholder="رقم الهاتف">
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full mb-6 text-sm min-w-[400px]">
                                <thead><tr class="bg-slate-100 border-b"><th class="p-3 text-right">المنتج</th><th class="p-3 text-center">الكمية</th><th class="p-3 text-center">السعر ($)</th><th class="p-3 text-center">الإجمالي ($)</th><th class="p-3 text-center">إجراء</th></tr></thead>
                                <tbody id="invoiceItems"></tbody>
                            </table>
                        </div>
                        <div class="border-t pt-4 space-y-2">
                            <div class="flex justify-between text-base md:text-lg font-bold"><span>المجموع بالدولار:</span><span id="grandTotalUSD" class="text-emerald-600">$0.00</span></div>
                            <div class="flex justify-between text-sm md:text-base font-bold text-slate-600"><span>المعادل بالليرة:</span><span id="grandTotalSYP" class="text-blue-600">0 ل.س</span></div>
                        </div>
                        <div class="mt-8 flex flex-wrap justify-end gap-3">
                            <button onclick="clearInvoice()" class="bg-slate-100 text-slate-700 px-4 py-2 rounded-lg text-sm font-bold">مسح الفاتورة</button>
                            <button onclick="processCheckoutAndDeduct()" class="bg-emerald-600 text-white px-6 py-2 rounded-lg text-sm font-bold shadow-sm">إتمام البيع وخصم المخزون</button>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- النوافذ المنبثقة -->
    <div id="addRawModal" class="fixed inset-0 bg-slate-900/50 hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-xl p-6 w-full max-w-md shadow-xl border">
            <h3 class="text-lg font-bold text-slate-800 mb-4 border-b pb-2">إضافة مادة أولية جديدة</h3>
            <form onsubmit="handleAddNewRawMaterial(event)" class="space-y-4">
                <div><label class="block text-xs font-bold text-slate-700 mb-1">اسم المادة</label><input type="text" id="newRawName" required class="w-full p-2 border rounded-lg text-sm"></div>
                <div><label class="block text-xs font-bold text-slate-700 mb-1">التكلفة ($)</label><input type="number" step="0.01" id="newRawCostUSD" required class="w-full p-2 border rounded-lg text-sm"></div>
                <div><label class="block text-xs font-bold text-slate-700 mb-1">الوحدة</label><input type="text" id="newRawUnit" value="قطعة" required class="w-full p-2 border rounded-lg text-sm"></div>
                <div><label class="block text-xs font-bold text-slate-700 mb-1">الكمية</label><input type="number" id="newRawStock" required value="100" class="w-full p-2 border rounded-lg text-sm"></div>
                <div class="flex justify-end gap-2 pt-2"><button type="button" onclick="toggleAddRawModal()" class="px-4 py-2 bg-slate-100 text-slate-600 rounded-lg text-sm">إلغاء</button><button type="submit" class="px-4 py-2 bg-purple-600 text-white rounded-lg text-sm font-bold">حفظ</button></div>
            </form>
        </div>
    </div>

    <div id="restockRawModal" class="fixed inset-0 bg-slate-900/50 hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-xl p-6 w-full max-w-md shadow-xl border">
            <h3 class="text-lg font-bold text-slate-800 mb-4 border-b pb-2">توريد كمية وتحديث سعر</h3>
            <form onsubmit="handleRestockRaw(event)" class="space-y-4">
                <div><label class="block text-xs font-bold text-slate-700 mb-1">اختر المادة:</label><select id="restockSelectId" onchange="onRestockMaterialSelect()" class="w-full p-2.5 border rounded-lg text-sm bg-slate-50 font-bold"></select></div>
                <div><label class="block text-xs font-bold text-slate-700 mb-1">الكمية المضافة:</label><input type="number" id="restockAddQty" required value="10" min="1" class="w-full p-2 border rounded-lg text-sm"></div>
                <div><label class="block text-xs font-bold text-slate-700 mb-1">التكلفة الجديدة ($):</label><input type="number" step="0.01" id="restockNewCostUSD" required class="w-full p-2 border rounded-lg text-sm"></div>
                <div class="flex justify-end gap-2 pt-2"><button type="button" onclick="toggleRestockRawModal()" class="px-4 py-2 bg-slate-100 text-slate-600 rounded-lg text-sm">إلغاء</button><button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-bold">تأكيد</button></div>
            </form>
        </div>
    </div>

    <div id="editRawModal" class="fixed inset-0 bg-slate-900/50 hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-xl p-6 w-full max-w-md shadow-xl border">
